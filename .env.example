# ─── Public (safe for the browser) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Mapbox public token (pk.*) — enables Mapbox satellite/streets layers.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Set to 1 if your Supabase plan includes image transformations (smaller thumbnails).
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=
# Optional: override tile servers for production (OSM's public tiles are for light use only).
NEXT_PUBLIC_TILES_STANDARD=
NEXT_PUBLIC_TILES_TOPO=

# ─── Server only (never prefixed with NEXT_PUBLIC_) ────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret required by /api/cron/* and /api/jobs/* endpoints.
CRON_SECRET=
# Contact string sent in the User-Agent to OSM/Wikimedia (required by their usage policies).
DATA_CONTACT=lumen-photo-atlas (+https://your-domain.example)
# Optional providers
WINDY_WEBCAMS_API_KEY=
FLICKR_API_KEY=
OPENROUTESERVICE_API_KEY=
# Optional: custom Overpass endpoint (defaults to overpass-api.de)
OVERPASS_URL=
# Discovery budget per 6-hour cycle
DISCOVERY_REGIONS_PER_CYCLE=6
REFRESH_LOCATIONS_PER_CYCLE=150
