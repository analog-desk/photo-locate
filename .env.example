# Copy to .env.local for local development.

# ─── Public — compiled into the static site (safe in the browser) ──────────────
# On GitHub these are repository *Variables* (Settings → Secrets and variables → Actions → Variables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Mapbox public token (pk.*) for Mapbox satellite/outdoors layers.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: tile servers for heavier traffic (OSM's public tiles are for light use only).
NEXT_PUBLIC_TILES_STANDARD=
NEXT_PUBLIC_TILES_TOPO=
# Set to 1 if your Supabase plan includes image transformations (smaller thumbnails).
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=
# Set automatically by the deploy workflow ("/<repo-name>"); leave empty locally.
NEXT_PUBLIC_BASE_PATH=

# ─── Private — only used by the six-hour refresh job (GitHub Actions *Secrets*) ──
SUPABASE_SERVICE_ROLE_KEY=
WINDY_WEBCAMS_API_KEY=
FLICKR_API_KEY=
OPENROUTESERVICE_API_KEY=
DATA_CONTACT=photo-locate (https://github.com/analog-desk/photo-locate)
DISCOVERY_REGIONS_PER_CYCLE=6
REFRESH_LOCATIONS_PER_CYCLE=150
